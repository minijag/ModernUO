<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
    <PropertyGroup>
        <Product>ModernUO Core</Product>
        <OutDir>..\..\..\Distribution\Build</OutDir>
        <PublishDir>..\..\..\Distribution\Build</PublishDir>
        <Version>0.0.0</Version>
        <Configurations>Debug;Release;Analyze</Configurations>
        <RootNamespace>Server</RootNamespace>
        <PackageId>Server</PackageId>
    </PropertyGroup>
    <Target Name="CleanPub" AfterTargets="Clean">
        <Message Text="Server: Removing distribution files..." />
        <Delete Files="..\..\..\Distribution\Build\$(AssemblyName)" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\$(AssemblyName).deps.json" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\$(AssemblyName).dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\$(AssemblyName).dll.config" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\$(AssemblyName).exe" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\$(AssemblyName).pdb" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\$(AssemblyName).runtimeconfig.dev.json" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\$(AssemblyName).runtimeconfig.json" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\ModernUO.Serialization.Annotations.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\CommunityToolkit.HighPerformance.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\IORingGroup.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\ioring.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\ref\$(AssemblyName).dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Serilog.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Serilog.Sinks.Async.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Serilog.Sinks.Console.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\LibDeflate.Bindings.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\libdeflate.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\libdeflate.dylib" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\System.IO.Hashing.dll" ContinueOnError="true" />
    </Target>
    <ItemGroup>
        <ProjectReference Include="..\Logger\Logger.csproj" />
        <PackageReference Include="IORingGroup" Version="1.0.13" />
        <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
        <PackageReference Include="LibDeflate.Bindings" Version="1.0.4" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.12" />

        <PackageReference Include="ModernUO.Serialization.Annotations" Version="4.2.0" />
        <PackageReference Include="ModernUO.Serialization.Generator" Version="4.2.0" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="Migrations/*.v*.json" />
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Server.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>UOContent.Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ModernSpawner.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
