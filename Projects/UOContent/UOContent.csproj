<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
    <PropertyGroup>
        <RootNamespace>Server</RootNamespace>
        <AssemblyName>UOContent</AssemblyName>
        <Product>ModernUO Content</Product>
        <OutDir>..\..\..\Distribution\Build\Assemblies</OutDir>
        <PublishDir>..\..\..\Distribution\Build\Assemblies</PublishDir>
        <Configurations>Debug;Release;Analyze</Configurations>
    </PropertyGroup>
    <Target Name="CleanPub" AfterTargets="Clean">
        <Message Text="UOContent: Removing distribution assemblies..." />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\Argon2.Bindings.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\libargon2.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\BouncyCastle.Cryptography.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\MailKit.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\MimeKit.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\Microsoft.Toolkit.HighPerformance.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\CommunityToolkit.HighPerformance.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\Microsoft.Extensions.FileSystemGlobbing.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\Serilog.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\Serilog.Sinks.Async.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\Serilog.Sinks.Console.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\System.Security.Cryptography.Pkcs.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\$(AssemblyName).dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\ref\$(AssemblyName).dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\$(AssemblyName).deps.json" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\$(AssemblyName).pdb" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\LibDeflate.Bindings.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\libdeflate.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\libdeflate.dylib" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\ZstdNet.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\libzstd.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\ModernUO.Serialization.Annotations.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\ModernUO.CodeGeneratedEvents.Annotations.dll" ContinueOnError="true" />
        <Delete Files="..\..\..\Distribution\Build\Assemblies\ModernUO.CodeGeneratedEvents.Generator.dll" ContinueOnError="true" />
    </Target>
    <ItemGroup>
        <ProjectReference Include="..\Logger\Logger.csproj" />
        <ProjectReference Include="..\Server\Server.csproj" Private="false" PrivateAssets="All" IncludeAssets="None">
            <IncludeInPackage>false</IncludeInPackage>
        </ProjectReference>
        <PackageReference Include="LibDeflate.Bindings" Version="1.0.4" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
        <PackageReference Include="MailKit" Version="4.18.0" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
        <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
        <PackageReference Include="Argon2.Bindings" Version="1.20.0" />
        <PackageReference Include="ModernUO.CodeGeneratedEvents.Annotations" Version="1.0.0" />
        <PackageReference Include="ModernUO.CodeGeneratedEvents.Generator" Version="1.0.3.2" PrivateAssets="all" />
        <PackageReference Include="ZstdNet" Version="1.5.7" />

        <PackageReference Include="ModernUO.Serialization.Annotations" Version="4.2.0" />
        <PackageReference Include="ModernUO.Serialization.Generator" Version="4.2.0" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="Migrations/*.v*.json" />
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>UOContent.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
