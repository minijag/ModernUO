  "Books": [
    {
      "Lines": [
        "The Labrynth remembers.",
        "Violet, amber and jade",
        "each have a twin. Step",
        "aside after crossing.",
        "The pale gate leads",
        "to the northern cave.",
        "The red gate leads to",
        "the Thorn Crown."
      ],
      "Name": "The Gardener's Warning",
      "X": 1804,
      "Z": 0,
      "Y": 927
    },
    {
      "Lines": [
        "Not every path is true.",
        "Walls are rooted here,",
        "but distance is a lie.",
        "Seek the white gate",
        "for the dungeon below.",
        "Bring allies before",
        "challenging the tower.",
        "Its crown is death."
      ],
      "Name": "The Silent Archive",
      "X": 1828,
      "Z": 0,
      "Y": 931
    },
    {
      "Lines": [
        "Sit with the stones.",
        "Let the wind pass.",
        "A wandering eye sees",
        "only another turning.",
        "The patient traveller",
        "remembers the colors.",
        "Even this garden has",
        "a path back home."
      ],
      "Name": "A Moment of Stillness",
      "X": 1848,
      "Z": 0,
      "Y": 955
    }
  ]
